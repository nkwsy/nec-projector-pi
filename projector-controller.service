[Unit]
Description=NEC PX803UL Web Controller
# Not gated on the network: mpv should grab the display and paint black as early
# as possible (elegant boot). Projector/network commands just retry once the
# network is up.
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/home/pi/nec-projector-pi
ExecStart=/home/pi/nec-projector-pi/venv/bin/python app.py
Restart=always
RestartSec=3

# Private runtime dir for mpv's IPC socket (/run/projector, mode 0700).
RuntimeDirectory=projector
RuntimeDirectoryMode=0700

# --- Headless (no desktop) display setup ---------------------------------
# One persistent mpv renders straight to the projector via DRM/KMS and holds a
# black frame from boot (config.json mpv_args must include "--vo=gpu",
# "--gpu-context=drm"). To modeset the screen mpv must become the DRM "master",
# which on a bare console needs root plus a free virtual terminal; we hand it
# tty1 and keep it free by masking getty@tty1 (see README §5). Boot to console.
User=root
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal

# --- Desktop alternative -------------------------------------------------
# If you instead run a desktop session, delete the five lines above and use:
#   User=pi
#   Environment=XDG_RUNTIME_DIR=/run/user/1000
#   Environment=WAYLAND_DISPLAY=wayland-0
#   Environment=DISPLAY=:0
# with plain (non-DRM) mpv_args, and enable Desktop Autologin.

[Install]
WantedBy=multi-user.target
